{
  "manifest_version": 3,
  "name": "Unscroll",
  "version": "1.0.0",
  "description": "A Firefox extension that automatically redirects YouTube shorts to their own watch page to prevent mindless scrolling 🕹️",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "unscroll@mebebruno",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "webNavigation"
  ],
  "host_permissions": [
    "*://youtube.com/*",
    "*://www.youtube.com/*",
    "*://m.youtube.com/*"
  ],
  "background": {
    "scripts": [
      "shared/url-converter.js",
      "background/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://youtube.com/*",
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": [
        "shared/url-converter.js",
        "content/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}